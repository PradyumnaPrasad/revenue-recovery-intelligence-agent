DATABASE_URL=postgresql+asyncpg://rria:rria@localhost:5432/rria
DATABASE_URL_SYNC=postgresql+psycopg2://rria:rria@localhost:5432/rria
ENV=dev
LLM_PROVIDER=gemini
# google-genai's Client() reads GEMINI_API_KEY automatically — get one free,
# no card, at aistudio.google.com. Confirm the actual free-tier model names
# at aistudio.google.com/rate-limit before setting these two (plan.md §6.8 /
# ADR-004) — Google's free-tier lineup changes fast, don't reuse an old value.
GEMINI_API_KEY=
# Verified live against a real account 31 Aug 2026 (both return 200, no
# billing error): gemini-2.5-flash / gemini-2.5-flash-lite are deprecated
# for new users as of this date, redirected to the 3.5 generation below.
LLM_MODEL_SMALL=gemini-3.5-flash-lite
LLM_MODEL_LARGE=gemini-3.5-flash
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
DAILY_ACTION_BUDGET=120
# Real SMTP sending for send_reminder/offer_payment_plan, added live in
# response to "make it real". Every generated customer email is
# fictitious, so every real send is redirected to DEMO_RECIPIENT_EMAIL
# (your own inbox) regardless of which customer it's nominally for.
# SMTP_PASSWORD must be a Gmail App Password (Google Account -> Security
# -> 2-Step Verification -> App Passwords), NOT your real Gmail password —
# Google blocks plain-password SMTP login entirely. Leave these blank to
# fall back to drafted-not-sent (no crash, just no real delivery).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEMO_RECIPIENT_EMAIL=
